{
    "compilerOptions": {
        "target": "ES2020",
        "useDefineForClassFields": true,
        "lib": [
            "ES2020",
            "DOM",
            "DOM.Iterable"
        ],
        "module": "ESNext",
        "skipLibCheck": true,
        "moduleResolution": "Bundler",
        "allowJs": true,
        "jsx": "react-jsx",
        "noEmit": true,
        "strict": false,
        "paths": {
            "#/*": [
                "./*"
            ]
        }
    },
    "include": [
        "src"
    ]
}